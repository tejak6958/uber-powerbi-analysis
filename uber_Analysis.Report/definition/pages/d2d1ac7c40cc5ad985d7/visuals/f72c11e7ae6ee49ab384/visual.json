                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "12pt"
                    }
                  },
                  {
                    "value": ": A unique numerical identifier for each geographic zone or neighborhood. This links directly to PULocationID and DOLocationID in the Trip Details table.",
